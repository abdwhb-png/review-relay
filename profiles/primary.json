{
    "model": "opencode-go/deepseek-v4.1-flash",
    "default_agent": "review",
    "agents": {
        "review": {
            "mode": "primary",
            "description": "Code review",
            "system": "Review for actionable regressions. Verify evidence and return a concise Markdown report."
        }
    },
    "permissions": [
        {
            "action": "*",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "glob",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "grep",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "read",
            "resource": "*.env*",
            "effect": "deny"
        }
    ],
    "provider": {
        "opencode-go": {
            "models": {
                "deepseek-v4.1-flash": {
                    "options": {
                        "reasoningEffort": "high"
                    }
                }
            }
        }
    }
}
